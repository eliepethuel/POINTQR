# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,.localhost,backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Fernet key for kiosk secrets at rest: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Frontend origin (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
CORS_ALLOWED_ORIGIN_REGEXES=^http://[a-z0-9-]+\.localhost:8080$
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://*.localhost:8080

# --- PostgreSQL ---
POSTGRES_DB=pointqr
POSTGRES_USER=pointqr_owner
POSTGRES_PASSWORD=change-me-owner
# Restricted runtime role (no superuser, no BYPASSRLS)
APP_DB_USER=pointqr_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgres://pointqr_app:change-me-app@postgres:5432/pointqr
MIGRATION_DATABASE_URL=postgres://pointqr_owner:change-me-owner@postgres:5432/pointqr

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (S3-compatible, SeaweedFS in development) ---
S3_ACCESS_KEY=pointqr
S3_SECRET_KEY=change-me-s3
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=pointqr

# --- E-mail (Mailpit in development) ---
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=PointQR <no-reply@pointqr.ci>
