# Copy to .env (`.\tasks.ps1 env` does it with random secrets). Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-with-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Fernet key for kiosk secrets at rest (generated by `tasks.ps1 env`)
FIELD_ENCRYPTION_KEY=

# --- Frontend origin (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_ORIGIN_REGEXES=^http://[a-z0-9-]+\.localhost:4200$
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://*.localhost:4200

# --- PostgreSQL 16 (local install) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pointqr
# Owner role: migrations and tests
POSTGRES_OWNER_USER=pointqr_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
# Runtime role: no superuser, no BYPASSRLS
APP_DB_USER=pointqr_app
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgres://pointqr_app:change-me-app@127.0.0.1:5432/pointqr
MIGRATION_DATABASE_URL=postgres://pointqr_owner:change-me-owner@127.0.0.1:5432/pointqr

# --- Redis protocol (Garnet locally, Redis in CI/production) ---
REDIS_URL=redis://127.0.0.1:6379/0

# Database connection pool (psycopg, ADR-0012). Keep workers x DB_POOL_MAX below max_connections.
DB_POOL=true
DB_POOL_MAX=10
